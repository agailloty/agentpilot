# Copy to deploy/.env and fill in real values before starting Docker Compose.
# Never commit deploy/.env to Git.

# Host IP to bind on the homelab machine (loopback by default; set to your Tailscale or LAN IP).
# Example Tailscale IP: 100.64.0.10
AGENTPILOT_BIND_IP=127.0.0.1

# Host port published by Docker Compose (`ports`).
AGENTPILOT_PORT=8080

# Comma-separated Bearer tokens (`name:scope:secret`).
# Generate each secret with: openssl rand -hex 32
AGENTPILOT_TOKENS=mobile-default:mobile:REPLACE_WITH_32_BYTE_HEX_TOKEN,runner-pc1:runner:REPLACE_WITH_32_BYTE_HEX_TOKEN

# Optional self-hosted ntfy server for approval/completion notifications (LAN/Tailscale only).
# Example: AGENTPILOT_NTFY_URL=http://100.64.0.10:8090
AGENTPILOT_NTFY_URL=
AGENTPILOT_NTFY_TOPIC=

# Inactivity window (ms) before an approval prompt notification is triggered.
AGENTPILOT_APPROVAL_IDLE_MS=1500
