{
  "$schema": "./schema.json",
  "agentId": "copilot",
  "name": "GitHub Copilot CLI",
  "launchCommand": "copilot",
  "commandCandidates": ["copilot"],
  "args": [],
  "chatMode": "headless",
  "headlessArgs": ["-p", "{prompt}", "--allow-all-tools"],
  "continueArgs": ["--continue"],
  "providerMenus": {
    "options": [
      {
        "id": "model",
        "label": "Model",
        "description": "AI model used by Copilot CLI (see the --model flag of `copilot --help`)",
        "flag": "--model",
        "defaultValue": "default",
        "choices": [
          { "value": "default", "label": "Default" },
          { "value": "auto", "label": "Auto (Copilot picks)" },
          { "value": "claude-sonnet-5.5", "label": "Claude Sonnet 5.5" },
          { "value": "claude-opus-5.5", "label": "Claude Opus 5.5" },
          { "value": "claude-haiku-5.5", "label": "Claude Haiku 5.5" },
          { "value": "claude-haiku-4.5", "label": "Claude Haiku 4.5" },
          { "value": "gpt-5.4", "label": "GPT-5.4" },
          { "value": "gpt-6.1-sol", "label": "GPT-6.1 Sol" },
          { "value": "gpt-6-astra", "label": "GPT-6 Astra" },
          { "value": "gpt-6-luna", "label": "GPT-6 Luna" },
          { "value": "gpt-5.3-codex", "label": "GPT-5.3 Codex" },
          { "value": "gemini-3.7-flash", "label": "Gemini 3.7 Flash" },
          { "value": "gemini-3.8-flash", "label": "Gemini 3.8 Flash" }
        ]
      }
    ],
    "inspectActions": [
      {
        "id": "version",
        "label": "CLI Version",
        "description": "Show installed GitHub Copilot CLI version",
        "args": ["--version"]
      },
      {
        "id": "help",
        "label": "CLI Help",
        "description": "Show Copilot CLI flags and usage (the --model line lists model IDs)",
        "args": ["--help"]
      }
    ]
  },
  "modelSync": {
    "optionId": "model",
    "args": ["--help"],
    "parser": "help-flag",
    "flag": "--model",
    "timeoutSec": 15
  },
  "commands": [
    {
      "name": "/help",
      "description": "Show available Copilot CLI commands and shortcuts",
      "sendsRaw": "/help\n"
    },
    {
      "name": "/clear",
      "description": "Clear the current conversation history",
      "sendsRaw": "/clear\n"
    },
    {
      "name": "/model",
      "description": "Select or switch the active AI model",
      "args": "[model]",
      "sendsRaw": "/model "
    },
    {
      "name": "/compact",
      "description": "Summarize and compact conversation context",
      "sendsRaw": "/compact\n"
    },
    {
      "name": "/diff",
      "description": "Review pending file diffs in the workspace",
      "sendsRaw": "/diff\n"
    },
    {
      "name": "/agent",
      "description": "Select or inspect available custom agents",
      "args": "[name]",
      "sendsRaw": "/agent "
    },
    {
      "name": "/mcp",
      "description": "Manage or inspect configured MCP servers",
      "sendsRaw": "/mcp\n"
    },
    {
      "name": "/cwd",
      "description": "Show or change the active working directory",
      "args": "[path]",
      "sendsRaw": "/cwd "
    },
    {
      "name": "/add-dir",
      "description": "Allow Copilot to access an additional directory",
      "args": "<path>",
      "sendsRaw": "/add-dir "
    },
    {
      "name": "/login",
      "description": "Authenticate GitHub Copilot CLI",
      "sendsRaw": "/login\n"
    },
    {
      "name": "/logout",
      "description": "Sign out of GitHub Copilot CLI",
      "sendsRaw": "/logout\n"
    },
    {
      "name": "/usage",
      "description": "Show session token and premium request usage",
      "sendsRaw": "/usage\n"
    },
    {
      "name": "/feedback",
      "description": "Submit feedback about Copilot CLI",
      "sendsRaw": "/feedback\n"
    },
    {
      "name": "/exit",
      "description": "Exit the Copilot CLI session",
      "sendsRaw": "/exit\n"
    }
  ],
  "approvalPatterns": [
    "(?i)(allow|approve|confirm|proceed|run command|apply changes).*\\(y/n\\)",
    "(?i)\\[y/n\\]",
    "(?i)do you want to",
    "(?i)yes, and don't ask again",
    "(?i)allow.*this tool"
  ],
  "env": {}
}
