{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentPilot Agent Manifest",
  "description": "Schema describing an interactive CLI agent or shell supported by AgentPilot.",
  "type": "object",
  "required": ["agentId", "name", "launchCommand"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "agentId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "Canonical identifier for the agent (e.g. shell, copilot, antigravity, mistral)."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable display name shown in the mobile UI."
    },
    "launchCommand": {
      "type": "string",
      "minLength": 1,
      "description": "Executable name or special token (e.g. __shell__) used to spawn the agent."
    },
    "commandCandidates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Optional candidate executable names probed in order when checking CLI availability."
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional default CLI arguments passed when spawning launchCommand."
    },
    "chatMode": {
      "type": "string",
      "enum": ["headless", "shell"],
      "description": "Execution mode for structured chat turns: headless CLI invocation or shell command execution."
    },
    "headlessArgs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "CLI argument template for headless chat turns supporting {cwd} and {prompt} placeholders."
    },
    "continueArgs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "CLI arguments appended on turn > 0 to preserve conversation continuity."
    },
    "providerMenus": {
      "type": "object",
      "additionalProperties": false,
      "description": "Provider-specific session options and safe read-only inspect actions.",
      "properties": {
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "flag", "choices"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "flag": {
                "type": "string",
                "minLength": 1
              },
              "defaultValue": {
                "type": "string"
              },
              "choices": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["value", "label"],
                  "additionalProperties": false,
                  "properties": {
                    "value": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        "inspectActions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "args"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "description": "Slash or quick commands exposed in the mobile command palette.",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Display name of the command (e.g. /help or pwd)."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Short description shown next to the command in the palette."
          },
          "args": {
            "type": "string",
            "description": "Optional argument signature hint (e.g. [path])."
          },
          "sendsRaw": {
            "type": "string",
            "description": "Optional exact text written when selected."
          }
        }
      }
    },
    "approvalPatterns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "format": "regex"
      },
      "description": "Regular expressions matched against output to detect confirmation prompts."
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Optional non-secret environment variables applied to spawned sessions."
    }
  }
}
